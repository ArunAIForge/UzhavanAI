{
  "info": {
    "_postman_id": "0d236e1b-28af-42d6-9c98-8c95a5f38fe5",
    "name": "Tamil Nadu Agriculture RAG API",
    "description": "Backend smoke and contract tests for the FastAPI agriculture RAG API. Run Health, Queries, Validation, and Schemes and filters for read-only verification. Ingestion requests perform real work against configured websites or PDFs on the API host; run them only when you intend to ingest or refresh data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string"
    },
    {
      "key": "schemeId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('reports API and vector store state', function () {",
                  "  pm.expect(body).to.have.property('status').that.is.oneOf(['ok', 'starting']);",
                  "  pm.expect(body.vector_store_loaded).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Dependency health (vector DB and LLM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('reports vector DB and LLM dependency states', function () {",
                  "  pm.expect(body.vector_database).to.be.an('object');",
                  "  pm.expect(body.vector_database.status).to.be.oneOf(['healthy', 'unavailable']);",
                  "  pm.expect(body.vector_database.vectors).to.be.a('number');",
                  "  pm.expect(body).to.have.property('llm');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health/dependencies"
          }
        }
      ]
    },
    {
      "name": "Queries",
      "item": [
        {
          "name": "Query indexed agriculture data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('returns the query and a controlled answer status', function () {",
                  "  pm.expect(body.query).to.eql('What subsidy is available for micro irrigation?');",
                  "  pm.expect(body.status).to.be.oneOf(['pass', 'refuse']);",
                  "  pm.expect(body.answer).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('sources and retrieval count have the documented shape', function () {",
                  "  pm.expect(body.sources).to.be.an('array');",
                  "  pm.expect(body.retrieval_count).to.eql(body.sources.length);",
                  "  body.sources.forEach(function (source) {",
                  "    pm.expect(source).to.have.property('id');",
                  "    pm.expect(source).to.have.property('url_or_file');",
                  "  });",
                  "});",
                  "pm.test('answer citations refer only to returned sources', function () {",
                  "  const citations = body.answer.match(/\\[S\\d+\\]/g) || [];",
                  "  const sourceIds = body.sources.map(function (source) { return '[' + source.id + ']'; });",
                  "  citations.forEach(function (citation) { pm.expect(sourceIds).to.include(citation); });",
                  "  if (body.status === 'pass') pm.expect(citations.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What subsidy is available for micro irrigation?\",\n  \"top_k\": 5,\n  \"filters\": {}\n}"
            },
            "url": "{{baseUrl}}/api/v1/query"
          }
        },
        {
          "name": "Stream query (Server-Sent Events)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200 as an event stream', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "pm.test('streams sources, answer tokens, and a terminal event', function () {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body).to.include('\"type\": \"sources\"');",
                  "  pm.expect(body).to.include('\"type\": \"token\"');",
                  "  pm.expect(body).to.include('data: [DONE]');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"சொட்டு நீர் பாசன மானியம் என்ன?\",\n  \"top_k\": 5,\n  \"filters\": {}\n}"
            },
            "url": "{{baseUrl}}/api/v1/query/stream"
          }
        }
      ]
    },
    {
      "name": "Validation",
      "description": "Read-only invalid-input checks; these should fail before query retrieval or ingestion starts.",
      "item": [
        {
          "name": "Reject unsupported query metadata filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects an unsupported query filter with HTTP 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('returns a validation detail', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.detail).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"micro irrigation subsidy\",\n  \"filters\": {\n    \"unsupported_filter\": \"value\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/query"
          }
        },
        {
          "name": "Reject unconfigured website ingestion URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects an unconfigured website with HTTP 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('returns a validation detail', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.detail).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"urls\": [\n    \"https://example.com/not-configured\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/ingestion/websites"
          }
        },
        {
          "name": "Return 404 for an unknown indexed scheme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 404 for an unknown scheme', function () { pm.response.to.have.status(404); });",
                  "pm.test('returns a clear not-found detail', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.detail).to.include('not found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/schemes/not-a-real-scheme-id"
          }
        }
      ]
    },
    {
      "name": "Schemes and filters",
      "item": [
        {
          "name": "List schemes (first page)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('returns a paginated scheme list', function () {",
                  "    pm.expect(body.items).to.be.an('array');",
                  "    pm.expect(body.total).to.be.a('number');",
                  "    pm.expect(body.page).to.eql(1);",
                  "    pm.expect(body.page_size).to.eql(20);",
                  "  });",
                  "  if (body.items && body.items.length > 0) {",
                  "    pm.environment.set('schemeId', body.items[0].scheme_id);",
                  "  }",
                  "} else {",
                  "  pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/schemes?page=1&page_size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schemes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Search schemes by keyword and filters",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('returns a paginated filtered result', function () {",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.total).to.be.a('number');",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.page_size).to.eql(10);",
                  "  body.items.forEach(function (item) {",
                  "    pm.expect((item.scheme_name + ' ' + item.description).toLowerCase()).to.include('irrigation');",
                  "    pm.expect((item.department || '').toLowerCase()).to.eql('agriculture');",
                  "    pm.expect((item.doc_type || '').toLowerCase()).to.eql('url');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/schemes?query=irrigation&department=Agriculture&doc_type=url&page=1&page_size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schemes"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "irrigation"
                },
                {
                  "key": "department",
                  "value": "Agriculture"
                },
                {
                  "key": "doc_type",
                  "value": "url"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get scheme detail (uses schemeId from List schemes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('returns detail for the selected indexed scheme', function () {",
                  "  pm.expect(body.scheme_id).to.eql(pm.environment.get('schemeId'));",
                  "  pm.expect(body.scheme_name).to.be.a('string').and.not.empty;",
                  "  pm.expect(body).to.have.property('source');",
                  "  pm.expect(body.page_numbers).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/schemes/{{schemeId}}"
          }
        },
        {
          "name": "Get available filter options",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('returns indexed string options for each supported filter', function () {",
                  "  ['departments', 'doc_types', 'scheme_names'].forEach(function (key) {",
                  "    pm.expect(body[key]).to.be.an('array');",
                  "    body[key].forEach(function (option) { pm.expect(option).to.be.a('string'); });",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/filters"
          }
        }
      ]
    },
    {
      "name": "Ingestion",
      "description": "These requests perform real ingestion on the API host. Run only when you intend to ingest or refresh configured websites/PDFs. PDF ingestion indexes files already in data/ or storage/pdfs/; there is no PDF-upload route. An active job causes HTTP 409.",
      "item": [
        {
          "name": "Start configured website ingestion (side effect)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted website ingestion job', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test('returns and saves a queued job identifier', function () {",
                  "  pm.expect(body.job_id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.kind).to.eql('websites');",
                  "  pm.expect(body.status).to.eql('queued');",
                  "  pm.environment.set('jobId', body.job_id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/v1/ingestion/websites"
          }
        },
        {
          "name": "Ingest selected configured websites",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted selected website ingestion job', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test('returns and saves a queued job identifier', function () {",
                  "  pm.expect(body.job_id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.kind).to.eql('websites');",
                  "  pm.expect(body.status).to.eql('queued');",
                  "  pm.environment.set('jobId', body.job_id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"urls\": [\n    \"https://agritech.tnau.ac.in/govt_schemes_services/kalaignar_agri_scheme.html\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/ingestion/websites"
          }
        },
        {
          "name": "Ingest PDFs from configured folders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted PDF ingestion job', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test('returns and saves a queued job identifier', function () {",
                  "  pm.expect(body.job_id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.kind).to.eql('pdfs');",
                  "  pm.expect(body.status).to.eql('queued');",
                  "  pm.environment.set('jobId', body.job_id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/ingestion/pdfs"
          }
        },
        {
          "name": "Refresh websites and PDFs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted refresh job', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test('returns and saves a queued job identifier', function () {",
                  "  pm.expect(body.job_id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.kind).to.eql('refresh');",
                  "  pm.expect(body.status).to.eql('queued');",
                  "  pm.environment.set('jobId', body.job_id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/ingestion/refresh"
          }
        },
        {
          "name": "Check ingestion job status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('reports progress for the saved job', function () {",
                  "  pm.expect(body.job_id).to.eql(pm.environment.get('jobId'));",
                  "  pm.expect(body.status).to.be.oneOf(['queued', 'running', 'completed', 'failed']);",
                  "  pm.expect(body.progress).to.be.a('number').and.within(0, 100);",
                  "  pm.expect(body.kind).to.be.oneOf(['websites', 'pdfs', 'refresh']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/ingestion/jobs/{{jobId}}"
          }
        }
      ]
    }
  ]
}
